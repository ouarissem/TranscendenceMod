		Achievement: {
			Title: Transcendence Achievements
			Notification: Achievement Get!
			Rewards: Rewards: {0}x [i:{1}] [c/586475:(Right Click to Claim)]

			Markers: {
				Start: Start
				End: Finish
			}

			Categories: {
				Prog: "[i:WoodenDoor] [C/fee86f:Progression]"
				EaM: "[i:EnchantedSword] [C/54f07b:Equipment and Mechanics]"
				Misc: "[i:SoulofFlight] [C/62b6ea:Miscellaneous]"
				Challenge: "[i:WallOfFleshGoatMountItem] [C/c54161:Challenge]"
			}

			Steps: {
				Begin: {
					DisplayName: The Beginning
					Tooltip: Open the Achievement Book
				}

				Parry: {
					DisplayName: +PARRY
					Tooltip: Obtain a parry from a [i:TranscendenceMod/Shield] [C/b5c1e0:Shield]
				}

				Modifier: {
					DisplayName: Curious Alterations
					Tooltip: Apply a modifier onto an item with the help of the Blacksmith
				}

				ModifierBag: {
					DisplayName: Convenient Alterations
					Tooltip: Obtain the [i:TranscendenceMod/ModifierContainer] [C/c87d6b:Magic Modifier Bag]
				}

				Snowman: {
					DisplayName: Chilly Business
					Tooltip: Talk to the friendly Snowman located within the icy caverns
				}

				CosmicNPC: {
					DisplayName: A Charitable Deed
					Tooltip: Talk to the Star Trader and give them the item they want
				}

				Timedial: {
					DisplayName: Timeless Artifact
					Tooltip: Combine the three [i:TranscendenceMod/TerrariaDial][i:TranscendenceMod/EtheriaDial][i:TranscendenceMod/ConstantDial] [C/c6a3e4:Time Fragments] into the [i:TranscendenceMod/Timedial] [C/c6a3e4:Timedial]
				}

				Hardmetal: {
					DisplayName: Heavy Metal
					Tooltip: Defeat the giant eye and mine [i:TranscendenceMod/HardmetalOre] [C/a1cfd2:Hardmetal Ore] from the depths of the caverns
				}

				Volcanic: {
					DisplayName: From the Depths
					Tooltip: Brave the volcanic layer and obtain [i:TranscendenceMod/VolcanicRemains] [C/f6a84b:Volcanic Remains]
				}

				Chalice: {
					DisplayName: Chalice
					Tooltip: Retrieve the [i:TranscendenceMod/ForgottenInferno] [C/db7a1a:Forgotten Inferno] from the volcanic caverns
				}

				Procession: {
					DisplayName: Processed Goods
					Tooltip: Craft the [i:Hellforge] [C/e54a56:Item Processer]
				}

				sans: {
					DisplayName: Bone Zone
					Tooltip: Defeat Skeletron, the torment of the elderly
				}

				Muramasa: {
					DisplayName: Scars of the Dungeon
					Tooltip: Defeat the Possessed Blade located deep within the halls of the Dungeon
				}

				Wall: {
					DisplayName: Seal Breaker
					Tooltip: Throw a [i:GuideVoodooDoll] [C/9dd159:Guide Voodoo Doll] into the lava and defeat the Wall of Flesh
				}

				Empress: {
					DisplayName: Like a Moth to the Flame
					Tooltip: Kill a [i:EmpressButterfly] [C/e5badc:Prismatic Lacewing] and defeat the Empress of Light
				}

				Moonlord: {
					DisplayName: The Call of the Moon
					Tooltip: Complete the Lunar Cult's ritual and defeat Moon Lord, the primordial beast
				}

				FrostSerpent: {
					DisplayName: Snow Grave
					Tooltip: Craft the [i:TranscendenceMod/HeartOfTheTundra] [C/2cbdf5:Heart of the Tundra] and defeat Frost Serpent, the glacial construct
				}

				Atmospheron: {
					DisplayName: Fast and Furious Beasts
					Tooltip: Defeat Atmospheron, the atmospheric wyvern
				}

				PoseidonFrag: {
					DisplayName: Secrets of the Catacombs
					Tooltip: Brave the upgraded Dungeon and obtain a [i:TranscendenceMod/PoseidonsTide] [C/7bb5ec:Poseidon's Fragment]
				}

				NucleusCaller: {
					DisplayName: Advanced Technologies
					Tooltip: Craft the [i:TranscendenceMod/NucleusSummonerItem] [C/b90d0d:Nucleus Caller]
				}

				Nucleus: {
					DisplayName: Judgment Day
					Tooltip: Defeat 'Project 1020-CTHL Nucleus', the biomechanical war machine
				}

				Artifact: {
					DisplayName: Artifact of Immense Power
					Tooltip: Craft the [i:TranscendenceMod/CosmicArtifact] [C/ec6db5:Cosmic Artifact]
				}

				Seraph: {
					DisplayName: ...To His strongest soldiers.
					Tooltip: Enter the Seraph's rift and defeat Celestial Seraph, the highest of angels
				}

				StarForge: {
					DisplayName: Forge of Gods
					Tooltip: Craft the [i:TranscendenceMod/StarcraftedForgeItem] [C/ef61b7:Starcrafted Forge]
				}

				EmpressChallenge: {
					DisplayName: Mystic Flight
					Tooltip:
						'''
						Defeat the Empress of Light under the following conditions:
						> [C/526377:You will have to use the Everglowing Tiara's lacewing transformation for the WHOLE fight]
						The following effects will apply during the fight:
						> [C/526377:Any projectiles except for the prismatic energy passive will be disabled]
						> [C/526377:You will die in a single hit]
						Notes:
						[C/526377:You must be transformed before the boss starts attacking]
						[C/526377:Time of the day and stage of progression doesn't matter]
						Difficulty:  [C/eaad25:Moderate]
						'''
				}

				DragonChallenge: {
					DisplayName: Blind Nightbird
					Tooltip:
						'''
						Defeat Atmospheron under the following conditions:
						> [C/526377:You have to be under the effects of Perpetual Blindness Stew for the WHOLE fight]
						> [C/526377:It must be nighttime]
						Notes:
						[C/526377:You must have the buff before the boss starts attacking]
						[C/526377:Stage of progression doesn't matter]
						Difficulty:  [C/eaad25:Moderate]
						'''
				}

				NucleusChallenge: {
					DisplayName: So Retro!
					Tooltip:
						'''
						Defeat Project Nucleus under the following conditions:
						> [C/526377:You will have to have the Rez 125S-T Model Laser Lens sight active for the WHOLE fight]
						Notes:
						[C/526377:You must have the effect active before the boss starts attacking]
						[C/526377:Stage of progression doesn't matter]
						Difficulty:  [C/eaad25:Moderate]
						'''
				}

				TwentyTwoChallenge: {
					DisplayName: Just How Many Birds is This?
					Tooltip:
						'''
						Split a bullet into 110 pieces or more in a single shot
						Difficulty:  [C/88ef45:Easy]
						'''
				}

				SeraphChallenge: {
					DisplayName: Crown of Thorns
					Tooltip:
						'''
						Defeat Celestial Seraph under the following conditions:
						> [C/526377:90% of the damage in the last phase must be done with Nail Gun]
						[C/526377:Stage of progression doesn't matter]
						Difficulty:  [C/eaad25:Moderate]
						'''
				}
			}
		}

